# Dockerfile.dev
FROM node:20-alpine
WORKDIR /app

# Install build dependencies for native modules (sqlite3)
RUN apk add --no-cache python3 make g++ sqlite-dev

COPY package*.json ./
RUN npm install
RUN npm install -g nodemon

COPY . .

EXPOSE 3000
CMD ["sh", "-c", "npm install && nodemon server.js"]